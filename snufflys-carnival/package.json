{
  "name": "snufflys-carnival",
  "version": "1.0.0",
  "description": "PWA do Snuffly's Carnival: jogos de carnaval pagos com premiação de bonecos e acessórios geek de papel e papelão.",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "db:init": "node server/scripts/db-init.js",
    "lint": "eslint server public/js public/jogos",
    "lint:fix": "eslint server public/js public/jogos --fix",
    "format": "prettier --write \"server/**/*.js\" \"public/**/*.js\" \"public/**/*.css\" \"!public/icons/**\"",
    "format:check": "prettier --check \"server/**/*.js\" \"public/**/*.js\" \"public/**/*.css\" \"!public/icons/**\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "prettier": "^3.4.2"
  }
}
