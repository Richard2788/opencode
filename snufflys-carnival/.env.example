# Snuffly's Carnival — exemplo de variáveis de ambiente
# Copie para `.env` e ajuste os valores.

# Banco PostgreSQL (local ou Render)
# Em dev, `npm run dev` sobe um Postgres embutido automaticamente e define
# DATABASE_URL para você — esta variável é opcional localmente.
# Em produção (Render), é definida pelo blueprint apontando para o banco gerenciado.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/snuffly

# Senha do painel de mensagens /admin/contatos (obrigatória em produção)
ADMIN_PASS=senha-do-painel

# Notificações instantâneas de novo contato (opcionais)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Porta local (Render define PORT automaticamente)
PORT=3000
